{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://project-management-backend-nine-tau.vercel.app",
        "EXPO_PUBLIC_TENANT_SLUG": "cubicassociates"
      }
    },
    "production-apk": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://project-management-backend-nine-tau.vercel.app",
        "EXPO_PUBLIC_TENANT_SLUG": "cubicassociates"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://project-management-backend-nine-tau.vercel.app",
        "EXPO_PUBLIC_TENANT_SLUG": "cubicassociates"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
