# Cubic mobile — environment variables
#
# Expo inlines any EXPO_PUBLIC_* variable into the JS bundle at build time.
# Never put secrets here — this is public, client-side config only.

# Full API origin (no trailing slash, no /api suffix).
# Leave unset during local development — src/constants/env.ts picks a sensible
# default per platform (iOS simulator, Android emulator, or your LAN IP for a
# physical device / Expo Go).
# EXPO_PUBLIC_API_URL=https://cubic-api.onrender.com

# Workspace slug sent as X-Tenant-Slug.
# Must match the company name typed on the website login (cubicassociates).
EXPO_PUBLIC_TENANT_SLUG=cubicassociates
